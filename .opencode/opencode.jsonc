{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "ollama-cloud/glm-5.3",
  // "model": "zai-coding-plan/glm-5.3",
  "small_model": "ollama-cloud/glm-5.3",
  // "small_model": "zai-coding-plan/glm-5.3",
  "instructions": [".opencode/OPENCODE.md"],
  "enabled_providers": ["ollama-cloud", "zai-coding-plan"],

  // MCP Servers
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.local/share/opencode/tavily.key}"
      }
    }
  },

  // Global permissions
  "permission": {
    "edit": "ask",
    "bash": "ask",

    "read": {
      "*": "allow",

      // Environment files
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".secrets": "deny",
      "secrets.yaml": "deny",
      "secrets.yml": "deny",
      "**/secrets/**": "deny",

      // SOPS encrypted files
      "*.sops.yaml": "deny",
      "*.sops.yml": "deny",
      "**/*.sops.yaml": "deny",
      "**/*.sops.yml": "deny",
      "**/*.enc": "deny",
      ".sops.yaml": "deny",
      ".decrypted~*": "deny",

      // SSH keys and certificates
      "*.key": "deny",
      "*.pem": "deny",
      "*.crt": "deny",
      "*.cer": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "id_rsa": "deny",
      "id_rsa.pub": "deny",
      "id_ed25519": "deny",
      "id_ed25519.pub": "deny",
      "**/.ssh/**": "deny",

      // Age/GPG encryption keys
      "keys.txt": "deny",
      "age.key": "deny",
      "*.age": "deny",
      "*.gpg": "deny",
      "*.asc": "deny",
      "*.pgp": "deny",

      // Kubeconfig
      "**/kubeconfig": "deny",
      "kubeconfig.*": "deny",
      "*.kubeconfig": "deny",

      // Ansible Vault
      "ansible-vault.*": "deny",

      // Terraform state
      "*.tfstate": "deny",
      "*.tfstate.*": "deny",
      "terraform.tfstate*": "deny",
      "terraform.tfvars": "deny",
      "terraform.tfvars.json": "deny",

      // Private directories
      ".private/**": "deny"
    }
  }
}
